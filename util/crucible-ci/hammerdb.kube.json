{
    "benchmarks": [
        {
            "name": "hammerdb",
            "ids": "1",
            "mv-params": {
                "sets": [
                    {
                        "params": [
                            { "arg": "backend", "vals": [ "mariadb" ] },
                            { "arg": "warehouses", "vals": [ "1" ] },
                            { "arg": "virtual-users", "vals": [ "2" ] },
                            { "arg": "rampup-minutes", "vals": [ "1" ] },
                            { "arg": "duration-minutes", "vals": [ "1" ] },
                            { "arg": "data-dir", "vals": [ "." ] },
                            { "arg": "log-dir", "vals": [ "." ] }
                        ]
                    }
                ]
            }
        }
    ],
    "tool-params": [
        { "tool": "sysstat" },
        { "tool": "procstat" },
        {
            "tool": "kernel",
            "params": [
                { "arg": "subtools", "val": "turbostat" }
            ]
        },
        { "tool": "forkstat" }
    ],
    "tags": {
        "description": "hammerdb-kube-ci-run-file-json"
    },
    "endpoints": [
        {
            "type": "kube",
            "controller-ip-address": "CONTROLLER_IP",
            "host": "CI_ENDPOINT_HOST",
            "user": "CI_ENDPOINT_USER",
            "engines": {
                "client": "1"
            },
            "config": [
                {
                    "targets": "default",
                    "settings": {
                        "cpu-partitioning": false
                    }
                }
            ]
        }
    ],
    "run-params": {
        "num-samples": 1,
        "test-order": "s"
    }
}
