{
    "benchmarks": [
        {
            "name": "coremark",
            "ids": "1",
            "mv-params": {
                "global-options": [
                    {
                        "name": "ci-representative",
                        "params": [
                            { "arg": "threads", "vals": [ "1" ] },
                            { "arg": "iterations", "vals": [ "0" ] },
                            { "arg": "deadline", "vals": [ "300" ] }
                        ]
                    }
                ],
                "sets": [
                    { "include": "ci-representative" }
                ]
            }
        }
    ],
    "tool-params": [
        { "tool": "sysstat" },
        { "tool": "procstat" },
        {
            "tool": "kernel",
            "params": [
                { "arg": "subtools", "val": "turbostat" }
            ]
        },
        { "tool": "forkstat" }
    ],
    "tags": {
        "description": "coremark-kube-ci-run-file-json"
    },
    "endpoints": [
        {
            "type": "kube",
            "controller-ip-address": "CONTROLLER_IP",
            "host": "CI_ENDPOINT_HOST",
            "user": "CI_ENDPOINT_USER",
            "engines": {
                "client": "1"
            },
            "config": [
                {
                    "targets": "default",
                    "settings": {
                        "cpu-partitioning": false
                    }
                }
            ]
        }
    ],
    "run-params": {
        "num-samples": 1,
        "test-order": "s"
    }
}
