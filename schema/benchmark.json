{
  "type": "object",
  "properties": {
    "rickshaw-benchmark": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^2020\\.05\\.18$"
            }
          },
          "required": [
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema"
      ],
      "additionalProperties": false
    },
    "benchmark": {
      "type": "string",
      "pattern": "^.+$"
    },
    "controller": {
      "type": "object",
      "properties": {
        "pre-script": {
          "type": "string",
          "pattern": "^.+$"
        },
        "post-script": {
          "type": "string",
          "pattern": "^.+$"
        }
      },
      "required": [
        "post-script"
      ],
      "additionalProperties": false
    },
    "client": {
      "type": "object",
      "properties": {
        "files-from-controller": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string",
                "pattern": "^.+$"
              },
              "dest": {
                "type": "string",
                "pattern": "^.+$"
              },
              "required": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "src",
              "dest"
            ]
          },
          "additionalItems": false
        },
        "client-server-ratio": {
          "type": "string",
          "pattern": "^.+$",
          "description": "Client/server topology. Use 1:N for the existing one-client-to-many-servers arrangement, or N:M to let every client receive service information from every server in the benchmark. If omitted, Rickshaw requires matching client/server IDs."
        },
        "runtime": {
          "type": "string",
          "pattern": "^.+$"
        },
        "infra": {
          "type": "string",
          "pattern": "^.+$"
        },
        "start": {
          "type": "string",
          "pattern": "^.+$"
        },
        "param_regex": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^.+$"
          },
          "additionalItems": false
        }
      },
      "additionalProperties": false,
      "required": [
        "files-from-controller",
        "runtime",
        "start"
      ]
    },
    "server": {
      "type": "object",
      "properties": {
        "files-from-controller": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string",
                "pattern": "^.+$"
              },
              "dest": {
                "type": "string",
                "pattern": "^.+$"
              },
              "required": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
              "required": [
                "src",
                "dest"
            ]
          },
          "additionalItems": false
        },
        "start": {
          "type": "string",
          "pattern": "^.+$"
        },
        "stop": {
          "type": "string",
          "pattern": "^.+$"
        },
        "param_regex": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^.+$"
          },
          "additionalItems": false
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "files-from-controller",
          "start",
          "stop"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "rickshaw-benchmark",
    "client",
    "controller",
    "benchmark"
  ]
}
